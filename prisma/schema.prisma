// ARCHITECTURE: Prisma schema is the persisted data contract for database-backed features.
// It defines durable relationships and constraints, while business workflows remain in lib/ services.
// Keep model names aligned with API/CMS/Calculation domain contracts; do not move UI concerns into schema.
// The future CalculationModelVersion/Calculation entities belong here when the new calculator core becomes persistent.
datasource db{provider="postgresql" url=env("DATABASE_URL")} generator client{provider="prisma-client-js"} model Service{id String @id @default(cuid()) slug String @unique name String category String description String deliverable String published Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt} model Case{id String @id @default(cuid()) slug String @unique title String category String location String? area String? technology String? task String result String deliverables String duration String? createdAt DateTime @default(now())} model KnowledgeItem{id String @id @default(cuid()) slug String @unique type String title String summary String body String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt} model Lead{id String @id @default(cuid()) phone String? email String? type String area Float? complexity Json? output String? estimate Json? status String @default("NEW") createdAt DateTime @default(now())} model Technology{id String @id @default(cuid()) slug String @unique name String short String createdAt DateTime @default(now())}