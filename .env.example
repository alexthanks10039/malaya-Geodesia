# PostgreSQL: required for persistent CMS, audit log, file metadata and durable rate limits
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set DATABASE_SSL=false only for a local database without TLS
# DATABASE_SSL=false
# Optional: max connections per serverless instance
# DB_POOL_MAX=5

# Studio authentication: required to log in to /studio
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
# Development only. Production ignores this switch.
# STUDIO_AUTH_DISABLED=true

# Vercel Blob: required for file uploads in Studio
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Telegram lead notifications and webhook (optional until Telegram is configured)
TG_KEY=
OWNER_ID=
TG_WEBHOOK_SECRET=
CRON_SECRET=

# Optional: allow seeded static content to appear if database has no published rows
# CMS_FALLBACK_TO_SEED=true
