# Production database connection
DATABASE_URL=

# Set DATABASE_SSL=false for a local non-TLS Postgres
DATABASE_SSL=false

# Public content falls back to lib/data until DB is seeded.
CMS_FALLBACK_TO_SEED=true

# Vercel Blob is configured by the Vercel project/storage integration.
# For local development with a manually configured Blob store, set:
# BLOB_READ_WRITE_TOKEN=
